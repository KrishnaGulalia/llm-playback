{
  "name": "llm-playback",
  "version": "0.3.0",
  "description": "Record and replay LLM API calls in tests. Zero dependencies, streaming-aware, secret-safe.",
  "author": "Krishna Gulalia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrishnaGulalia/llm-playback.git"
  },
  "bugs": {
    "url": "https://github.com/KrishnaGulalia/llm-playback/issues"
  },
  "homepage": "https://github.com/KrishnaGulalia/llm-playback#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "llm-playback": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "testing",
    "vcr",
    "record",
    "replay",
    "mock",
    "fetch",
    "cassette",
    "playback",
    "streaming",
    "sse",
    "vitest"
  ],
  "peerDependencies": {
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@types/node": "^26.6.6",
    "openai": "^7.62.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}